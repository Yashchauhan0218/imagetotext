---
// src/pages/imagem-para-pdf.astro - Página dedicada para o conversor de Imagem para PDF com SEO Completo
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ImageToPdfHero from '../components/ImageToPdf/ImageToPdfHero.astro';
import ImageToPdfApp from '../components/ImageToPdf/ImageToPdfApp.astro';
import ImageToPdfFeatures from '../components/ImageToPdf/ImageToPdfFeatures.astro';
import ImageToPdfSeo from '../components/ImageToPdf/ImageToPdfSeo.astro';
import ImageToPdfFaq from '../components/ImageToPdf/ImageToPdfFaq.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Converter Imagem para PDF Grátis Online - Juntar JPG e PNG em PDF";
const pageDescription = "Converta imagens para PDF grátis online em segundos. Junte fotos JPG, PNG e WebP em um único arquivo PDF com ajuste de margens e orientação. 100% privado no navegador.";
const pageKeywords = "imagem para pdf, converter imagem para pdf, converter foto em pdf, jpg para pdf, png para pdf, juntar fotos em pdf, transformar imagem em pdf, converter jpg em pdf gratis, unir imagens em pdf, foto para pdf online, converter jpeg em pdf";
const canonicalUrl = "https://imagemparatexto.com/imagem-para-pdf";

// Structured Schema Data (JSON-LD) for Search Engines
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://imagemparatexto.com/imagem-para-pdf#webapp",
      "name": "Conversor de Imagem para PDF Grátis Online",
      "url": "https://imagemparatexto.com/imagem-para-pdf",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": ["pt-BR", "pt-PT", "pt"],
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "BRL"
      },
      "featureList": [
        "Conversão e junção de JPG, PNG, WebP e BMP para PDF",
        "Geração 100% no Navegador sem Envio a Servidores (Zero Upload)",
        "Reorganização Visual de Páginas e Rotação 90°",
        "Configuração de Margens e Formatos A4 e Carta",
        "Sem Marcas d'Água e Sem Limites de Páginas"
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://imagemparatexto.com/imagem-para-pdf#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://imagemparatexto.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Imagem para PDF",
          "item": "https://imagemparatexto.com/imagem-para-pdf"
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://imagemparatexto.com/imagem-para-pdf#howto",
      "name": "Como Converter Imagens para PDF Online Grátis",
      "description": "Passo a passo rápido para juntar fotos e converter imagens em PDF pelo navegador.",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Carregue as Imagens",
          "text": "Arraste e solte seus arquivos JPG, PNG ou WebP na área de upload ou use o atalho Ctrl+V para colar imagens."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Ajuste a Ordem e as Margens",
          "text": "Reordene as miniaturas para ajustar a sequência das páginas, gire fotos em 90° e selecione o tamanho de folha desejado (A4 ou Carta)."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Baixe o PDF Pronto",
          "text": "Clique em Baixar PDF Agora para compilar e salvar o documento no seu dispositivo instantaneamente."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://imagemparatexto.com/imagem-para-pdf#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "É seguro converter imagens de documentos confidenciais neste site?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim, 100% seguro. Nosso conversor opera sob uma arquitetura de Zero-Upload. Toda a renderização e compilação do PDF ocorrem localmente no seu navegador, sem envio para servidores externos."
          }
        },
        {
          "@type": "Question",
          "name": "Como juntar várias fotos em um único arquivo PDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Selecione múltiplas fotos na área de upload, organize a ordem das miniaturas e clique no botão Baixar PDF Agora."
          }
        },
        {
          "@type": "Question",
          "name": "O PDF gerado terá marca d'água?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. Todos os arquivos gerados são limpos e profissionais, sem qualquer logotipo ou marca d'água."
          }
        },
        {
          "@type": "Question",
          "name": "Quais formatos de imagem são suportados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O conversor aceita JPG/JPEG, PNG, WebP, BMP e GIF estático."
          }
        },
        {
          "@type": "Question",
          "name": "Posso girar fotos deitadas antes de gerar o PDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim, cada miniatura possui um botão de rotação 90° para corrigir a orientação antes da exportação."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalUrl={canonicalUrl}
  schemaData={schemaData}
>
  <Navbar />
  
  <main class="flex-1">
    <ImageToPdfHero />
    <ImageToPdfApp />
    <ImageToPdfFeatures />
    <ImageToPdfSeo />
    <ImageToPdfFaq />
  </main>

  <Footer />
</Layout>
