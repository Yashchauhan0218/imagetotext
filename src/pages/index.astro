---
// src/pages/index.astro - Página inicial compacta, visual e focada no produto (Product-First)
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ConverterApp from '../components/Converter/ConverterApp.astro';
import TrustSection from '../components/TrustSection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import BeforeAfterDemo from '../components/BeforeAfterDemo.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import RelatedTool from '../components/RelatedTool.astro';
import FAQ from '../components/FAQ.astro';
import SeoContent from '../components/SeoContent.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Imagem para Texto - Conversor de Imagem para Texto Grátis & IA"
  description="Converter imagem para texto e código grátis online com IA. Transcrever imagem para texto, extrair texto de imagem, extrator de texto OCR e 100% privado no navegador."
  keywords="imagem para texto, converter imagem para texto, conversor de imagem para texto, transcrever imagem para texto, extrair texto de imagem, extrator de texto, extrator de texto de imagem, imagem para codigo, ocr online gratis, copiar texto de imagem"
>
  <Navbar />
  <main class="flex-1" id="main-content">
    <!-- 1. HERO: Minimalista levando diretamente ao conversor -->
    <Hero />

    <!-- 2. TOOL FIRST: Ferramenta OCR interativa principal -->
    <ConverterApp />

    <!-- 3. TRUST STRIP: Barra horizontal compacta de confiança -->
    <TrustSection />

    <!-- 4. HOW IT WORKS: 3 passos simples -->
    <HowItWorks />

    <!-- 5. BEFORE / AFTER: Exemplo visual compacto -->
    <BeforeAfterDemo />

    <!-- 6. FEATURES: Grade com 4 recursos principais -->
    <FeatureGrid />

    <!-- 7. RELATED TOOL: Imagem para PDF -->
    <RelatedTool />

    <!-- 8. FAQ: 5 perguntas essenciais com schema FAQPage -->
    <FAQ />

    <!-- 9. SEO CONTENT: Seção concisa e informativa -->
    <SeoContent />

    <!-- 10. FINAL CTA: Retorno rápido para a ferramenta -->
    <FinalCta />
  </main>
  <Footer />
</Layout>
