---
// TrustSection.astro - Barra compacta horizontal de confiança logo abaixo do conversor OCR
---

<section class="py-4 bg-[var(--color-canvas)] border-y border-[var(--color-hairline)]" aria-label="Garantia de Confiança e Privacidade">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-center gap-2 text-center">
      <!-- Horizontal Trust Badges -->
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs sm:text-sm font-medium text-[var(--color-ink)]">
        <span class="inline-flex items-center gap-1.5">
          <span>🔒</span>
          <span>Processamento local</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span>⚡</span>
          <span>Rápido</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span>🆓</span>
          <span>Gratuito</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span>🚫</span>
          <span>Sem cadastro</span>
        </span>
      </div>

      <!-- Short Reassurance Line -->
      <p class="text-xs text-[var(--color-mute)] font-normal">
        Suas imagens são processadas diretamente no navegador.
      </p>
    </div>
  </div>
</section>
