---
// FAQ.astro - Componente FAQ conciso em acordeom com 5 perguntas essenciais e JSON-LD FAQPage
const faqs = [
  {
    q: "Como converter uma imagem em texto?",
    a: "Arraste ou selecione sua imagem na ferramenta no topo da página, ou cole diretamente com Ctrl + V. Em seguida, selecione o modo desejado (Texto, Código ou Tabela) e clique em 'Extrair texto'. O conteúdo reconhecido pode ser editado e copiado imediatamente."
  },
  {
    q: "Minhas imagens são armazenadas?",
    a: "Não. O processamento OCR acontece diretamente no seu navegador usando WebAssembly. Suas fotos, capturas de tela e documentos não são enviados para servidores externos nem armazenados."
  },
  {
    q: "Quais formatos são suportados?",
    a: "O conversor suporta os formatos PNG, JPG, JPEG, WEBP, GIF, HEIC (fotos de iPhone) e BMP, além de documentos em PDF."
  },
  {
    q: "Posso extrair código de uma imagem?",
    a: "Sim. Ao escolher o modo 'Código', o conversor preserva indentações e caracteres especiais da programação, formatando o código com destaque de sintaxe."
  },
  {
    q: "Posso usar a ferramenta gratuitamente?",
    a: "Sim. A ferramenta é gratuita, não requer cadastro e pode ser utilizada quantas vezes você precisar diretamente no seu navegador."
  }
];

// JSON-LD Dados Estruturados para FAQPage SEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": ["pt-BR", "pt-PT", "pt"],
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<section id="faq" class="py-10 sm:py-14 bg-[var(--color-canvas)] border-b border-[var(--color-hairline)]" aria-label="Perguntas Frequentes">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-8 sm:mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-ink)]">
        Perguntas Frequentes
      </h2>
    </div>

    <!-- Accessible Accordion List -->
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] p-4 sm:p-5 transition-all shadow-2xs open:shadow-xs open:border-[var(--color-hairline-strong)]" open={index === 0}>
          <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-[var(--color-ink)] cursor-pointer list-none select-none focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] rounded-lg">
            <span>{faq.q}</span>
            <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-mute)] transition-transform duration-200 group-open:rotate-180 group-open:text-[var(--color-ink)]" aria-hidden="true">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="mt-3 pt-3 border-t border-[var(--color-hairline)] text-xs sm:text-sm text-[var(--color-body)] leading-relaxed font-normal">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<!-- JSON-LD FAQPage Schema para Mecanismos de Busca -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
