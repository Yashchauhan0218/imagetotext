---
// BeforeAfterDemo.astro - Exemplo visual compacto de OCR em ação (Antes e Depois)
---

<section class="py-10 sm:py-14 bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]" aria-label="Exemplo Visual do OCR">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-ink)]">
        Veja o OCR em ação
      </h2>
      <p class="mt-2 text-sm text-[var(--color-body)] leading-relaxed font-normal">
        Veja como o OCR transforma uma imagem em texto editável.
      </p>
    </div>

    <!-- Visual Layout: [ IMAGEM ] → [ TEXTO EXTRAÍDO ] -->
    <div class="max-w-3xl mx-auto flex flex-col md:flex-row items-center justify-center gap-4 sm:gap-6">
      
      <!-- LEFT: Imagem de Entrada -->
      <div class="w-full md:flex-1 rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-4 sm:p-5 shadow-2xs flex flex-col justify-between">
        <div class="flex items-center justify-between pb-3 border-b border-[var(--color-hairline)] mb-3">
          <span class="text-xs font-mono font-semibold text-[var(--color-ink)] uppercase">Imagem</span>
          <span class="text-[11px] font-mono text-[var(--color-mute)]">recibo.png</span>
        </div>

        <!-- Visual Image Snapshot -->
        <div class="rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft-2)] p-4 font-mono text-xs shadow-inner select-none space-y-2 text-[var(--color-ink)]">
          <div class="w-20 h-2.5 bg-[var(--color-hairline-strong)] rounded"></div>
          <div class="p-3 bg-[var(--color-canvas)] rounded border border-[var(--color-hairline)] space-y-1 text-[11px]">
            <p class="font-bold text-[var(--color-ink)]">Fatura</p>
            <p class="text-[var(--color-body)]">Cliente: João Silva</p>
            <p class="font-semibold text-[var(--color-ink)]">Total: R$ 245,90</p>
          </div>
        </div>

        <div class="mt-3 pt-2 border-t border-[var(--color-hairline)] text-[11px] text-[var(--color-mute)]">
          Documento ou foto original
        </div>
      </div>

      <!-- Arrow Indicator -->
      <div class="flex items-center justify-center text-[var(--color-mute)] shrink-0 py-1 md:py-0">
        <svg class="w-5 h-5 transform rotate-90 md:rotate-0 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </div>

      <!-- RIGHT: Texto Extraído -->
      <div class="w-full md:flex-1 rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-4 sm:p-5 shadow-2xs flex flex-col justify-between">
        <div class="flex items-center justify-between pb-3 border-b border-[var(--color-hairline)] mb-3">
          <span class="text-xs font-mono font-semibold text-[var(--color-ink)] uppercase">Texto Extraído</span>
          <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-medium">Resultado do OCR</span>
        </div>

        <!-- Extracted Text Area -->
        <div class="rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] p-4 font-mono text-xs select-text space-y-1 text-[11px] text-[var(--color-ink)] leading-relaxed">
          <p class="font-bold">Fatura</p>
          <p class="text-[var(--color-body)]">Cliente: João Silva</p>
          <p class="font-semibold">Total: R$ 245,90</p>
        </div>

        <div class="mt-3 pt-2 border-t border-[var(--color-hairline)] text-[11px] text-[var(--color-mute)] flex items-center justify-between">
          <span>Pronto para copiar e editar</span>
        </div>
      </div>

    </div>

    <!-- Action Button to Scroll to Real OCR Tool -->
    <div class="mt-7 text-center">
      <a
        href="#converter-app"
        id="demo-test-image-btn"
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-full text-sm font-semibold text-[var(--color-on-primary)] bg-[var(--color-primary)] hover:opacity-90 transition-all shadow-xs active:scale-95 cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--color-primary)]"
      >
        <span>Testar minha imagem &rarr;</span>
      </a>
    </div>

  </div>
</section>
