---
// FeatureGrid.astro - Premium feature cards with colored icon backgrounds
---

<section id="recursos" class="py-10 sm:py-14 bg-[var(--color-canvas)] border-b border-[var(--color-hairline)]" aria-label="Recursos do Conversor">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
      <div class="section-label mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-violet-500" aria-hidden="true"></span>
        <span>Recursos</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--color-ink)]">
        Texto, código e tabelas
      </h2>
    </div>

    <!-- 4 Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-5xl mx-auto">

      <!-- Card 1: Texto -->
      <div class="feature-card">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4 text-indigo-600 dark:text-indigo-400" style="background:rgba(99,102,241,0.1);">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 7V4h16v3"></path>
            <path d="M9 20h6"></path>
            <path d="M12 4v16"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-[var(--color-ink)] tracking-tight mb-1.5">Texto</h3>
        <p class="text-sm text-[var(--color-body)] leading-relaxed font-normal">
          Extraia texto de imagens e documentos.
        </p>
      </div>

      <!-- Card 2: Código -->
      <div class="feature-card">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4 text-violet-600 dark:text-violet-400" style="background:rgba(139,92,246,0.1);">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
        </div>
        <h3 class="text-base font-bold text-[var(--color-ink)] tracking-tight mb-1.5">Código</h3>
        <p class="text-sm text-[var(--color-body)] leading-relaxed font-normal">
          Converta screenshots de código com destaque de sintaxe.
        </p>
      </div>

      <!-- Card 3: Tabelas -->
      <div class="feature-card">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4 text-emerald-600 dark:text-emerald-400" style="background:rgba(16,185,129,0.1);">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="3" y1="15" x2="21" y2="15"></line>
            <line x1="9" y1="3" x2="9" y2="21"></line>
            <line x1="15" y1="3" x2="15" y2="21"></line>
          </svg>
        </div>
        <h3 class="text-base font-bold text-[var(--color-ink)] tracking-tight mb-1.5">Tabelas</h3>
        <p class="text-sm text-[var(--color-body)] leading-relaxed font-normal">
          Extraia dados de tabelas e faturas.
        </p>
      </div>

      <!-- Card 4: Multi-imagem -->
      <div class="feature-card">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4 text-pink-600 dark:text-pink-400" style="background:rgba(236,72,153,0.1);">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
        </div>
        <h3 class="text-base font-bold text-[var(--color-ink)] tracking-tight mb-1.5">Várias imagens</h3>
        <p class="text-sm text-[var(--color-body)] leading-relaxed font-normal">
          Processe várias imagens de uma vez.
        </p>
      </div>

    </div>

    <!-- Footer note -->
    <div class="mt-8 text-center text-xs text-[var(--color-mute)]">
      Suporte para câmera, URL e colagem direta com <kbd class="font-mono text-[11px] px-1.5 py-0.5 bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] rounded text-[var(--color-ink)]">Ctrl+V</kbd>
    </div>

  </div>
</section>
