---
// FeatureGrid.astro - Grade compacta com apenas 4 recursos principais
---

<section id="recursos" class="py-10 sm:py-14 bg-[var(--color-canvas)] border-b border-[var(--color-hairline)]" aria-label="Recursos do Conversor">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-ink)]">
        Recursos para texto, código e tabelas
      </h2>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-5xl mx-auto">
      
      <!-- Card 1: Texto -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="w-9 h-9 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] flex items-center justify-center text-base mb-3.5 shadow-xs">
          📝
        </div>
        <h3 class="text-base font-bold text-[var(--color-ink)] tracking-tight">
          Texto
        </h3>
        <p class="mt-1.5 text-xs sm:text-sm text-[var(--color-body)] leading-relaxed font-normal">
          Extraia texto de imagens e documentos.
        </p>
      </div>

      <!-- Card 2: Código -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="w-9 h-9 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] flex items-center justify-center text-base mb-3.5 shadow-xs">
          💻
        </div>
        <h3 class="text-base font-bold text-[var(--color-ink)] tracking-tight">
          Código
        </h3>
        <p class="mt-1.5 text-xs sm:text-sm text-[var(--color-body)] leading-relaxed font-normal">
          Converta screenshots de código.
        </p>
      </div>

      <!-- Card 3: Tabelas -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="w-9 h-9 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] flex items-center justify-center text-base mb-3.5 shadow-xs">
          📊
        </div>
        <h3 class="text-base font-bold text-[var(--color-ink)] tracking-tight">
          Tabelas
        </h3>
        <p class="mt-1.5 text-xs sm:text-sm text-[var(--color-body)] leading-relaxed font-normal">
          Extraia dados de tabelas e faturas.
        </p>
      </div>

      <!-- Card 4: Várias imagens -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="w-9 h-9 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] flex items-center justify-center text-base mb-3.5 shadow-xs">
          📁
        </div>
        <h3 class="text-base font-bold text-[var(--color-ink)] tracking-tight">
          Várias imagens
        </h3>
        <p class="mt-1.5 text-xs sm:text-sm text-[var(--color-body)] leading-relaxed font-normal">
          Processe várias imagens de uma vez.
        </p>
      </div>

    </div>

    <!-- Small Secondary Capabilities Note -->
    <div class="mt-6 text-center text-xs text-[var(--color-mute)] font-normal">
      Suporte adicional para captura por câmera, importação por link/URL e colar direto com <kbd class="font-mono text-[11px] px-1.5 py-0.5 bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] rounded text-[var(--color-ink)]">Ctrl + V</kbd>.
    </div>

  </div>
</section>
