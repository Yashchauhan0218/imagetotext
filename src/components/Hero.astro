---
// Hero.astro - Compact hero: reduced headings, responsive, inline upload card
---

<section class="relative pt-8 pb-6 sm:pt-12 sm:pb-8 overflow-hidden mesh-gradient-bg" aria-label="Hero">

  <!-- Subtle dot grid -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: radial-gradient(circle, rgba(99,102,241,0.07) 1px, transparent 1px); background-size: 28px 28px; mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 55%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 55%, transparent 100%);"
    aria-hidden="true"
  ></div>

  <!-- Ambient glow — using inline style to avoid Tailwind opacity fraction bug -->
  <div
    class="absolute rounded-full pointer-events-none blur-3xl"
    style="top: -60px; left: 50%; transform: translateX(-50%); width: min(700px, 100%); height: 220px; background: radial-gradient(ellipse at center, rgba(99,102,241,0.12), rgba(139,92,246,0.05), transparent);"
    aria-hidden="true"
  ></div>

  <div class="relative w-full max-w-2xl mx-auto px-4 sm:px-6 text-center">

    <!-- H1 — compact, responsive -->
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-[var(--color-ink)] leading-tight mb-2">
      Imagem para&nbsp;<span class="mesh-gradient-text">Texto</span>&nbsp;em segundos
    </h1>

    <!-- Subtitle — short -->
    <p class="text-sm text-[var(--color-body)] mb-6 font-normal max-w-sm mx-auto leading-relaxed">
      Extraia texto de fotos, documentos e capturas de tela.
    </p>

    <!-- ── INLINE HERO UPLOAD CARD ─────────────────────────── -->
    <div
      id="hero-upload-card"
      class="relative w-full rounded-2xl border-2 border-dashed bg-[var(--color-canvas)] transition-all duration-200 cursor-pointer overflow-hidden"
      style="border-color: rgba(203,208,216,0.7);"
      role="button"
      tabindex="0"
      aria-label="Clique ou arraste uma imagem para converter"
    >
      <!-- Gradient top bar (visible on hover via JS) -->
      <div id="hero-card-bar" class="h-0.5 w-full bg-gradient-to-r from-indigo-500 via-violet-500 to-pink-500 opacity-0 transition-opacity duration-300" aria-hidden="true"></div>

      <div class="px-4 py-6 sm:py-7 flex flex-col items-center gap-3">

        <!-- Upload icon -->
        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl flex items-center justify-center text-indigo-600 dark:text-indigo-400 transition-transform duration-200" style="background: rgba(99,102,241,0.08); border: 1px solid rgba(99,102,241,0.18);" id="hero-upload-icon">
          <svg class="w-5 h-5 sm:w-6 sm:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </div>

        <!-- Label -->
        <div>
          <p class="text-sm font-semibold text-[var(--color-ink)] mb-0.5">
            Arraste sua imagem aqui
          </p>
          <p class="text-xs text-[var(--color-mute)]">
            ou clique para selecionar
          </p>
        </div>

        <!-- Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-2 w-full">
          <button
            type="button"
            id="hero-browse-btn"
            class="btn-primary text-xs sm:text-sm px-4 py-2 sm:px-5 sm:py-2.5 flex-shrink-0"
            aria-label="Escolher imagem"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            Escolher imagem
          </button>
          <button
            type="button"
            id="hero-paste-btn"
            class="btn-secondary text-xs px-3 py-2 sm:px-4 sm:py-2.5 flex-shrink-0"
            aria-label="Colar imagem com Ctrl+V"
          >
            <kbd class="not-italic font-semibold font-mono text-[var(--color-primary-accent)]">Ctrl+V</kbd>
            <span class="text-[var(--color-mute)] font-normal font-sans"> Colar</span>
          </button>
        </div>

        <!-- Formats -->
        <p class="text-[10px] font-mono text-[var(--color-mute)] tracking-wide leading-none">
          PNG · JPG · WEBP · PDF · HEIC · BMP
        </p>

      </div>
    </div>
    <!-- ── END HERO UPLOAD CARD ─────────────────────────── -->

  </div>
</section>

<script>
  // ── Hero card interactivity ──────────────────────────────
  const card     = document.getElementById('hero-upload-card') as HTMLElement | null;
  const bar      = document.getElementById('hero-card-bar') as HTMLElement | null;
  const icon     = document.getElementById('hero-upload-icon') as HTMLElement | null;
  const browseBtn = document.getElementById('hero-browse-btn') as HTMLElement | null;
  const pasteBtn  = document.getElementById('hero-paste-btn') as HTMLElement | null;
  const fileInput = document.getElementById('file-input') as HTMLInputElement | null;

  // Smooth scroll to converter (accounts for sticky navbar height)
  function goToConverter() {
    const target = document.getElementById('converter-app');
    if (!target) return;
    const navH = (document.getElementById('site-header')?.offsetHeight ?? 64);
    const top = target.getBoundingClientRect().top + window.scrollY - navH - 8;
    window.scrollTo({ top, behavior: 'smooth' });
  }

  // Hover state
  function setHover(on: boolean) {
    if (!card || !bar || !icon) return;
    card.style.borderColor = on ? 'rgba(99,102,241,0.5)' : 'rgba(203,208,216,0.7)';
    bar.style.opacity = on ? '1' : '0';
    icon.style.transform = on ? 'scale(1.06)' : 'scale(1)';
  }
  card?.addEventListener('mouseenter', () => setHover(true));
  card?.addEventListener('mouseleave', () => setHover(false));

  // Click card body → scroll + open picker
  card?.addEventListener('click', (e: MouseEvent) => {
    const target = e.target as Node;
    if (browseBtn?.contains(target) || pasteBtn?.contains(target)) return;
    goToConverter();
    setTimeout(() => fileInput?.click(), 420);
  });

  card?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      goToConverter();
      setTimeout(() => fileInput?.click(), 420);
    }
  });

  // Browse button
  browseBtn?.addEventListener('click', (e: MouseEvent) => {
    e.stopPropagation();
    goToConverter();
    setTimeout(() => fileInput?.click(), 420);
  });

  // Paste button → scroll only (user then pastes with Ctrl+V)
  pasteBtn?.addEventListener('click', (e: MouseEvent) => {
    e.stopPropagation();
    goToConverter();
  });

  // Drag & drop on hero card
  card?.addEventListener('dragover', (e: DragEvent) => {
    e.preventDefault();
    setHover(true);
  });

  card?.addEventListener('dragleave', () => setHover(false));

  card?.addEventListener('drop', (e: DragEvent) => {
    e.preventDefault();
    setHover(false);
    const dt = e.dataTransfer;
    if (!dt || !fileInput || dt.files.length === 0) return;
    try {
      const transfer = new DataTransfer();
      Array.from(dt.files).forEach(f => transfer.items.add(f));
      fileInput.files = transfer.files;
      fileInput.dispatchEvent(new Event('change', { bubbles: true }));
    } catch (_) { /* ignore DataTransfer errors in some browsers */ }
    goToConverter();
  });
</script>
