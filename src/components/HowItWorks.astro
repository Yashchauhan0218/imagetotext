---
// HowItWorks.astro - Seção concisa em 3 passos
---

<section id="como-funciona" class="py-10 sm:py-14 bg-[var(--color-canvas)] border-b border-[var(--color-hairline)]" aria-label="Como Funciona">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-ink)]">
        Como funciona?
      </h2>
    </div>

    <!-- 3 Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-4xl mx-auto">
      
      <!-- Step 1 -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="w-9 h-9 rounded-xl bg-[var(--color-primary)] text-[var(--color-on-primary)] font-mono font-bold text-sm flex items-center justify-center mb-4 shadow-xs">
          ①
        </div>
        <h3 class="text-base font-bold text-[var(--color-ink)] tracking-tight">
          Envie sua imagem
        </h3>
        <p class="mt-1.5 text-sm text-[var(--color-body)] leading-relaxed font-normal">
          Escolha, arraste ou cole.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="w-9 h-9 rounded-xl bg-[var(--color-primary)] text-[var(--color-on-primary)] font-mono font-bold text-sm flex items-center justify-center mb-4 shadow-xs">
          ②
        </div>
        <h3 class="text-base font-bold text-[var(--color-ink)] tracking-tight">
          Extraia o texto
        </h3>
        <p class="mt-1.5 text-sm text-[var(--color-body)] leading-relaxed font-normal">
          Nosso OCR reconhece o conteúdo.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="w-9 h-9 rounded-xl bg-[var(--color-primary)] text-[var(--color-on-primary)] font-mono font-bold text-sm flex items-center justify-center mb-4 shadow-xs">
          ③
        </div>
        <h3 class="text-base font-bold text-[var(--color-ink)] tracking-tight">
          Copie o resultado
        </h3>
        <p class="mt-1.5 text-sm text-[var(--color-body)] leading-relaxed font-normal">
          Edite e copie o texto extraído.
        </p>
      </div>

    </div>

  </div>
</section>
