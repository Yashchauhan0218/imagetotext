---
// UseCases.astro - Casos de uso práticos e objetivos
---

<section class="py-14 sm:py-20 bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]" aria-label="Casos de Uso">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[var(--color-mute)]">Aplicações Diárias</span>
      <h2 class="mt-2 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-[var(--color-ink)]">
        Para que você pode usar?
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[var(--color-body)] leading-relaxed font-normal">
        Produtividade para estudantes, programadores, empresas e criadores.
      </p>
    </div>

    <!-- 5 Cards Layout -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
      
      <!-- Card 1 -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="text-2xl mb-3">🎓</div>
        <h3 class="text-sm font-bold text-[var(--color-ink)]">
          Estudos
        </h3>
        <p class="mt-1.5 text-xs text-[var(--color-body)] leading-relaxed font-normal">
          Extraia texto de livros, slides e anotações.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="text-2xl mb-3">💻</div>
        <h3 class="text-sm font-bold text-[var(--color-ink)]">
          Programação
        </h3>
        <p class="mt-1.5 text-xs text-[var(--color-body)] leading-relaxed font-normal">
          Transforme screenshots de código em texto editável.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="text-2xl mb-3">🧾</div>
        <h3 class="text-sm font-bold text-[var(--color-ink)]">
          Trabalho
        </h3>
        <p class="mt-1.5 text-xs text-[var(--color-body)] leading-relaxed font-normal">
          Extraia informações de documentos, recibos e faturas.
        </p>
      </div>

      <!-- Card 4 -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="text-2xl mb-3">📱</div>
        <h3 class="text-sm font-bold text-[var(--color-ink)]">
          Capturas de tela
        </h3>
        <p class="mt-1.5 text-xs text-[var(--color-body)] leading-relaxed font-normal">
          Converta rapidamente screenshots em texto.
        </p>
      </div>

      <!-- Card 5 -->
      <div class="p-5 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-2xs hover:border-[var(--color-hairline-strong)] transition-all">
        <div class="text-2xl mb-3">✍️</div>
        <h3 class="text-sm font-bold text-[var(--color-ink)]">
          Conteúdo
        </h3>
        <p class="mt-1.5 text-xs text-[var(--color-body)] leading-relaxed font-normal">
          Extraia textos de imagens e materiais visuais.
        </p>
      </div>

    </div>

  </div>
</section>
