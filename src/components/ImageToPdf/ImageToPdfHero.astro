---
// ImageToPdfHero.astro - Hero Section concisa e focada no produto para Imagem para PDF
---

<section class="relative pt-8 pb-4 sm:pt-12 sm:pb-6 overflow-hidden mesh-gradient-bg">
  <!-- Subtle decorative grid -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#00000008_1px,transparent_1px),linear-gradient(to_bottom,#00000008_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Small Eyebrow -->
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-2xs mb-4">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse" aria-hidden="true"></span>
      <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-[var(--color-body)]">
        CONVERSOR PDF ONLINE
      </span>
    </div>

    <!-- H1 Principal -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-[-0.04em] text-[var(--color-ink)] max-w-4xl mx-auto leading-[1.12]">
      Converta Imagens em <span class="mesh-gradient-text">PDF Online</span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-4 text-base sm:text-lg text-[var(--color-body)] max-w-2xl mx-auto leading-relaxed font-normal">
      Junte fotos JPG, PNG e WebP em um único documento PDF em poucos segundos.
    </p>
  </div>
</section>
