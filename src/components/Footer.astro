---
// Footer.astro - Rodapé moderno organizado em colunas semânticas
const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--color-canvas)] border-t border-[var(--color-hairline)] pt-12 pb-16" aria-label="Rodapé do Site">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 lg:gap-12 pb-12 border-b border-[var(--color-hairline)]">
      
      <!-- Brand Col -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2.5 mb-4 group" aria-label="Imagem Para Texto - Página Inicial">
          <div class="w-8 h-8 rounded-lg bg-[var(--color-primary)] text-[var(--color-on-primary)] flex items-center justify-center shadow-xs">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>
          <span class="font-bold text-base tracking-tight text-[var(--color-ink)]">Imagem Para Texto</span>
        </a>
        <p class="text-xs text-[var(--color-body)] max-w-sm leading-relaxed mb-4 font-normal">
          Conversor de imagem para texto e OCR online com processamento local no navegador via WebAssembly. Simples, rápido e privado.
        </p>
        <div class="flex items-center gap-2 text-xs font-mono">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[var(--color-canvas-soft-2)] text-[var(--color-ink)] border border-[var(--color-hairline)]">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
            <span>Processamento 100% no Navegador</span>
          </span>
        </div>
      </div>

      <!-- Col 1: Ferramentas -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink)] font-bold mb-3">Ferramentas</h3>
        <ul class="space-y-2 text-xs text-[var(--color-body)]">
          <li><a href="/#converter-app" class="hover:text-[var(--color-ink)] transition-colors">Imagem para Texto</a></li>
          <li><a href="/imagem-para-pdf" class="hover:text-[var(--color-ink)] transition-colors">Imagem para PDF</a></li>
          <li><a href="/#converter-app" class="hover:text-[var(--color-ink)] transition-colors">Código de Imagem OCR</a></li>
          <li><a href="/#converter-app" class="hover:text-[var(--color-ink)] transition-colors">Extrator de Tabelas</a></li>
          <li><a href="/#converter-app" class="hover:text-[var(--color-ink)] transition-colors">OCR de Recibos & Faturas</a></li>
        </ul>
      </div>

      <!-- Col 2: Empresa -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink)] font-bold mb-3">Empresa</h3>
        <ul class="space-y-2 text-xs text-[var(--color-body)]">
          <li><a href="/about" class="hover:text-[var(--color-ink)] transition-colors">Sobre Nós</a></li>
          <li><a href="/contact" class="hover:text-[var(--color-ink)] transition-colors">Contato</a></li>
          <li><a href="/#recursos" class="hover:text-[var(--color-ink)] transition-colors">Recursos da IA</a></li>
          <li><a href="/#privacidade" class="hover:text-[var(--color-ink)] transition-colors">Por Que Nós</a></li>
          <li><a href="/#faq" class="hover:text-[var(--color-ink)] transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Col 3: Privacidade & Termos -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink)] font-bold mb-3">Privacidade & Termos</h3>
        <ul class="space-y-2 text-xs text-[var(--color-body)]">
          <li><a href="/privacy-policy" class="hover:text-[var(--color-ink)] transition-colors">Política de Privacidade</a></li>
          <li><a href="/terms" class="hover:text-[var(--color-ink)] transition-colors">Termos de Uso</a></li>
          <li><a href="/about#arquitetura" class="hover:text-[var(--color-ink)] transition-colors">Arquitetura Zero-Upload</a></li>
          <li><a href="/contact#dpo" class="hover:text-[var(--color-ink)] transition-colors">DPO</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--color-mute)] font-mono">
      <div>
        &copy; {currentYear} Imagem Para Texto (imagemparatexto.com). Todos os direitos reservados.
      </div>
      <div class="flex items-center gap-4">
        <span>Gratuito & OCR no Navegador</span>
      </div>
    </div>

  </div>
</footer>
