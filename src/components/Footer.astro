---
// Footer.astro - Premium footer with gradient brand mark
const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--color-canvas-soft)] border-t border-[var(--color-hairline)] pt-14 pb-10" aria-label="Rodapé do Site">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 lg:gap-12 pb-12 border-b border-[var(--color-hairline)]">

      <!-- Brand Col -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2.5 mb-5 group" aria-label="Imagem Para Texto - Página Inicial">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white flex items-center justify-center shadow-lg shadow-indigo-500/25 group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>
          <span class="font-bold text-[15px] tracking-tight text-[var(--color-ink)]">Imagem Para Texto</span>
        </a>
        <p class="text-xs text-[var(--color-body)] max-w-sm leading-relaxed mb-5">
          Conversor OCR online com processamento local via WebAssembly. Simples, rápido e privado.
        </p>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-emerald-500/10 dark:bg-emerald-500/15 border border-emerald-500/20 text-xs font-medium text-emerald-700 dark:text-emerald-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          Processamento 100% no Navegador
        </div>
      </div>

      <!-- Ferramentas -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-[var(--color-ink)] mb-4">Ferramentas</h3>
        <ul class="space-y-2.5 text-sm text-[var(--color-body)]">
          <li><a href="/#converter-app" class="hover:text-[var(--color-ink)] transition-colors">Imagem para Texto</a></li>
          <li><a href="/imagem-para-pdf" class="hover:text-[var(--color-ink)] transition-colors">Imagem para PDF</a></li>
          <li><a href="/#converter-app" class="hover:text-[var(--color-ink)] transition-colors">Código OCR</a></li>
          <li><a href="/#converter-app" class="hover:text-[var(--color-ink)] transition-colors">Extrator de Tabelas</a></li>
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-[var(--color-ink)] mb-4">Empresa</h3>
        <ul class="space-y-2.5 text-sm text-[var(--color-body)]">
          <li><a href="/about" class="hover:text-[var(--color-ink)] transition-colors">Sobre Nós</a></li>
          <li><a href="/contact" class="hover:text-[var(--color-ink)] transition-colors">Contato</a></li>
          <li><a href="/#faq" class="hover:text-[var(--color-ink)] transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-[var(--color-ink)] mb-4">Legal</h3>
        <ul class="space-y-2.5 text-sm text-[var(--color-body)]">
          <li><a href="/privacy-policy" class="hover:text-[var(--color-ink)] transition-colors">Privacidade</a></li>
          <li><a href="/terms" class="hover:text-[var(--color-ink)] transition-colors">Termos de Uso</a></li>
          <li><a href="/contact#dpo" class="hover:text-[var(--color-ink)] transition-colors">DPO</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[var(--color-mute)]">
      <div>
        &copy; {currentYear} Imagem Para Texto (imagemparatexto.com). Todos os direitos reservados.
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-1 h-1 rounded-full bg-indigo-500" aria-hidden="true"></span>
        <span>Gratuito &amp; OCR no Navegador</span>
      </div>
    </div>

  </div>
</footer>
