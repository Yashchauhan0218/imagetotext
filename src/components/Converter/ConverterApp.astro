---
// ConverterApp.astro - Aplicativo interativo principal de Imagem para Texto & Código OCR
---

<section id="converter-app" class="relative pt-4 pb-12 sm:pb-16 scroll-mt-20" aria-label="Ferramenta Conversor OCR">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- App Container Card -->
    <div class="rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] shadow-lg shadow-indigo-500/04 overflow-hidden transition-all duration-300">
      
      <!-- Top Control Bar / Mode Selector (Section 5) -->
      <div class="px-4 sm:px-6 py-4 bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        
        <!-- Mode Segmented Controls (Section 5) -->
        <div class="grid grid-cols-3 gap-1.5 bg-[var(--color-canvas-soft-2)] p-1 rounded-xl border border-[var(--color-hairline)]" role="tablist" aria-label="Modo de Reconhecimento OCR">
          
          <!-- Mode 1: Texto (Default) -->
          <button
            type="button"
            class="mode-tab-btn active text-left px-2 sm:px-3 py-1.5 rounded-lg transition-all flex flex-col sm:flex-row items-center sm:items-center gap-1 sm:gap-2 bg-[var(--color-canvas)] text-[var(--color-ink)] border border-[var(--color-hairline-strong)] shadow-xs ring-1 ring-[var(--color-primary)]/20 cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--color-primary)]"
            data-mode="text"
            id="tab-mode-text"
            role="tab"
            aria-selected="true"
          >
            <div class="w-6 h-6 rounded-md bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 7V4h16v3"></path>
                <path d="M9 20h6"></path>
                <path d="M12 4v16"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs sm:text-sm font-semibold tracking-tight leading-tight">📝 Texto</div>
              <div class="text-[10px] text-[var(--color-mute)] hidden sm:block leading-tight">Extraia texto comum</div>
            </div>
          </button>

          <!-- Mode 2: Código -->
          <button
            type="button"
            class="mode-tab-btn text-left px-2 sm:px-3 py-1.5 rounded-lg transition-all flex flex-col sm:flex-row items-center sm:items-center gap-1 sm:gap-2 text-[var(--color-body)] hover:text-[var(--color-ink)] border border-transparent cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--color-primary)]"
            data-mode="code"
            id="tab-mode-code"
            role="tab"
            aria-selected="false"
          >
            <div class="w-6 h-6 rounded-md bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <div>
              <div class="text-xs sm:text-sm font-semibold tracking-tight leading-tight">💻 Código</div>
              <div class="text-[10px] text-[var(--color-mute)] hidden sm:block leading-tight">Extraia código de screenshots</div>
            </div>
          </button>

          <!-- Mode 3: Tabela -->
          <button
            type="button"
            class="mode-tab-btn text-left px-2 sm:px-3 py-1.5 rounded-lg transition-all flex flex-col sm:flex-row items-center sm:items-center gap-1 sm:gap-2 text-[var(--color-body)] hover:text-[var(--color-ink)] border border-transparent cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--color-primary)]"
            data-mode="table"
            id="tab-mode-table"
            role="tab"
            aria-selected="false"
          >
            <div class="w-6 h-6 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="3" y1="15" x2="21" y2="15"></line>
                <line x1="9" y1="3" x2="9" y2="21"></line>
                <line x1="15" y1="3" x2="15" y2="21"></line>
              </svg>
            </div>
            <div>
              <div class="text-xs sm:text-sm font-semibold tracking-tight leading-tight">📊 Tabela</div>
              <div class="text-[10px] text-[var(--color-mute)] hidden sm:block leading-tight">Extraia dados de tabelas</div>
            </div>
          </button>
        </div>

        <!-- Language & Engine Settings -->
        <div class="flex items-center justify-end gap-3 shrink-0">
          <div class="flex items-center gap-2 text-xs text-[var(--color-body)]">
            <label for="ocr-language-select" class="text-xs text-[var(--color-body)] font-medium whitespace-nowrap">Idioma do texto:</label>
            <select
              id="ocr-language-select"
              class="text-xs bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-lg px-2.5 py-1.5 text-[var(--color-ink)] font-medium focus:outline-none focus:border-[var(--color-primary)] cursor-pointer"
              aria-label="Idioma do texto para o OCR"
            >
              <option value="por" selected>Português (Brasil & Portugal)</option>
              <option value="eng">Inglês (Código / Geral)</option>
              <option value="spa">Espanhol (Español)</option>
              <option value="fra">Francês (Français)</option>
              <option value="deu">Alemão (Deutsch)</option>
              <option value="ita">Italiano (Italiano)</option>
              <option value="jpn">Japonês (日本語)</option>
              <option value="chi_sim">Chinês (简体中文)</option>
              <option value="rus">Russo (Русский)</option>
            </select>
          </div>

          <!-- Auto-Enhance Toggle -->
          <label class="hidden md:inline-flex items-center gap-1.5 text-xs text-[var(--color-body)] cursor-pointer select-none">
            <input type="checkbox" id="toggle-auto-enhance" class="rounded border-[var(--color-hairline)] text-[var(--color-primary)] focus:ring-0 cursor-pointer" checked />
            <span class="text-[11px] font-medium">Auto Contraste</span>
          </label>
        </div>
      </div>

      <!-- MAIN STATE 1: PRIMARY UPLOAD ZONE (Section 3 & Section 4) -->
      <div id="upload-zone" class="p-6 sm:p-10 lg:p-12 text-center transition-all duration-200">
        <div
          id="drop-area"
          class="relative border-2 border-dashed border-[var(--color-hairline-strong)]/60 rounded-2xl p-8 sm:p-12 lg:p-14 hover:border-[var(--color-primary)] hover:bg-[var(--color-canvas-soft-2)]/40 transition-all duration-200 cursor-pointer group focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] shadow-2xs"
          role="button"
          tabindex="0"
          aria-label="Área de upload de imagem para extração de texto"
        >
          <input
            type="file"
            id="file-input"
            class="hidden"
            accept="image/png,image/jpeg,image/webp,image/gif,image/bmp,image/heic,application/pdf"
            multiple
          />

          <!-- Upload Graphic / Icon -->
          <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-4 rounded-2xl bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] flex items-center justify-center text-[var(--color-ink)] group-hover:scale-105 group-hover:border-[var(--color-primary)] transition-all shadow-xs">
            <svg class="w-8 h-8 sm:w-10 sm:h-10 text-[var(--color-ink)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
          </div>

          <!-- Drag and Drop Text -->
          <h2 class="text-xl sm:text-2xl font-bold text-[var(--color-ink)] tracking-tight">
            Arraste sua imagem aqui
          </h2>
          <p class="mt-1.5 text-xs sm:text-sm text-[var(--color-body)] max-w-md mx-auto font-normal">
            ou clique para procurar no seu dispositivo
          </p>

          <!-- Primary & Secondary Buttons -->
          <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
            <button
              type="button"
              id="browse-btn"
              class="px-6 py-3 text-sm font-semibold text-[var(--color-on-primary)] bg-[var(--color-primary)] hover:opacity-90 rounded-full shadow-md transition-all active:scale-95 flex items-center gap-2 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)]"
            >
              <span>📤 Escolher imagem</span>
            </button>

            <!-- URL Input Trigger -->
            <button
              type="button"
              id="url-import-trigger"
              class="px-4 py-2.5 text-xs sm:text-sm font-medium text-[var(--color-ink)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] hover:bg-[var(--color-canvas-soft-2)] rounded-full transition-colors flex items-center gap-2 shadow-2xs cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--color-primary)]"
            >
              <svg class="w-4 h-4 text-[var(--color-body)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
              <span>Por URL</span>
            </button>

            <!-- Camera Trigger -->
            <button
              type="button"
              id="camera-trigger"
              class="px-4 py-2.5 text-xs sm:text-sm font-medium text-[var(--color-ink)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] hover:bg-[var(--color-canvas-soft-2)] rounded-full transition-colors flex items-center gap-2 shadow-2xs cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--color-primary)]"
            >
              <svg class="w-4 h-4 text-[var(--color-body)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
              <span>Câmera</span>
            </button>
          </div>

          <!-- Section 4: Formats & Ctrl+V Line -->
          <div class="mt-7 pt-4 border-t border-[var(--color-hairline)]/80 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-3 text-xs text-[var(--color-mute)] font-mono">
            <span>PNG • JPG • JPEG • WEBP • GIF • HEIC • BMP • PDF</span>
            <span class="hidden sm:inline text-[var(--color-hairline-strong)]">•</span>
            <span class="font-sans">Você também pode colar uma imagem com <kbd class="font-mono text-[11px] font-semibold px-2 py-0.5 bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] rounded text-[var(--color-ink)]">Ctrl + V</kbd></span>
          </div>
        </div>

        <!-- Section 8: Sample Image Feature -->
        <div class="mt-4 pt-2 flex flex-wrap items-center justify-center gap-2 text-xs text-[var(--color-body)]">
          <span>Não tem uma imagem agora?</span>
          <button
            type="button"
            id="sample-image-trigger"
            class="font-semibold text-[var(--color-ink)] hover:text-[var(--color-primary)] flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[var(--color-canvas)] border border-[var(--color-hairline)] hover:bg-[var(--color-canvas-soft-2)] shadow-2xs transition-all cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--color-primary)]"
          >
            <span>🧪 Testar com imagem de exemplo</span>
          </button>
        </div>

        <!-- URL Input Inline Drawer (Hidden by default) -->
        <div id="url-input-container" class="hidden mt-4 max-w-lg mx-auto flex items-center gap-2">
          <input
            type="url"
            id="image-url-input"
            placeholder="Cole o link direto da imagem (ex: https://exemplo.com/foto.png)"
            class="flex-1 px-3.5 py-2 text-sm bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-lg text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-primary)] font-mono text-xs"
            aria-label="URL direta da imagem"
          />
          <button
            type="button"
            id="submit-url-btn"
            class="px-4 py-2 text-sm font-medium text-[var(--color-on-primary)] bg-[var(--color-primary)] rounded-lg hover:opacity-90 transition-colors cursor-pointer"
          >
            Carregar
          </button>
        </div>
      </div>

      <!-- MAIN STATE 2: WORKSPACE (When image is loaded) -->
      <div id="workspace-view" class="hidden">
        
        <!-- Multi-image tabs / Queue bar -->
        <div id="queue-bar" class="px-4 py-2.5 bg-[var(--color-canvas-soft-2)] border-b border-[var(--color-hairline)] flex items-center justify-between gap-4 overflow-x-auto">
          <div class="flex items-center gap-2" id="queue-items-container">
            <!-- Dynamic thumbnails will be injected here -->
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <button
              type="button"
              id="add-more-btn"
              class="px-3 py-1.5 text-xs font-semibold text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer"
            >
              <span>🔄 Nova imagem</span>
            </button>
            <button
              type="button"
              id="clear-all-btn"
              class="px-3 py-1.5 text-xs font-semibold text-red-600 hover:text-red-700 bg-[var(--color-canvas)] border border-red-200 dark:border-red-900/60 rounded-lg hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors flex items-center gap-1 cursor-pointer"
            >
              <span>🧹 Limpar</span>
            </button>
          </div>
        </div>

        <!-- Split Grid Workspace -->
        <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[560px]">
          
          <!-- LEFT PANE: Image Viewer & Pre-processing (5 cols) -->
          <div class="lg:col-span-5 bg-[var(--color-canvas-soft)] p-4 sm:p-5 border-b lg:border-b-0 lg:border-r border-[var(--color-hairline)] flex flex-col justify-between">
            <div>
              <!-- Left Toolbar -->
              <div class="flex items-center justify-between mb-3 text-xs">
                <span class="font-mono text-[11px] text-[var(--color-body)] font-medium flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
                  <span id="image-meta-info">Imagem de Origem</span>
                </span>
                
                <!-- Image Adjust Controls -->
                <div class="flex items-center gap-1 bg-[var(--color-canvas)] p-0.5 rounded-lg border border-[var(--color-hairline)]">
                  <button type="button" id="btn-rotate-ccw" class="p-1 text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] rounded cursor-pointer" title="Girar 90° para a Esquerda" aria-label="Girar 90 graus para a esquerda">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="1 4 1 10 7 10"></polyline>
                      <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                    </svg>
                  </button>
                  <button type="button" id="btn-rotate-cw" class="p-1 text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] rounded cursor-pointer" title="Girar 90° para a Direita" aria-label="Girar 90 graus para a direita">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="23 4 23 10 17 10"></polyline>
                      <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                    </svg>
                  </button>
                  <button type="button" id="btn-filter-binarize" class="p-1 text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] rounded cursor-pointer" title="Alternar Filtro de Alto Contraste" aria-label="Alternar filtro de alto contraste">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor"></path>
                    </svg>
                  </button>
                  <button type="button" id="btn-reset-image" class="p-1 text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] rounded text-[11px] font-mono cursor-pointer" title="Redefinir Filtros">
                    Redefinir
                  </button>
                </div>
              </div>

              <!-- Main Canvas / Image Container -->
              <div class="relative w-full aspect-[4/3] max-h-[380px] bg-[var(--color-canvas)] rounded-xl border border-[var(--color-hairline)] overflow-hidden flex items-center justify-center p-2 group shadow-2xs">
                <canvas id="image-canvas" class="max-w-full max-h-full object-contain rounded transition-transform"></canvas>
              </div>
            </div>

            <!-- OCR Trigger Bar -->
            <div class="mt-4 pt-4 border-t border-[var(--color-hairline)] flex items-center justify-between gap-3">
              <button
                type="button"
                id="process-ocr-btn"
                class="px-6 py-2.5 text-sm font-semibold text-[var(--color-on-primary)] bg-[var(--color-primary)] hover:opacity-90 rounded-full shadow-xs transition-all active:scale-95 flex items-center gap-2 cursor-pointer"
              >
                <span id="ocr-btn-text">✨ Extrair texto</span>
              </button>

              <div class="text-right">
                <span id="ocr-status-pill" class="text-xs font-medium text-[var(--color-body)]">🟢 Pronto para processar</span>
              </div>
            </div>
          </div>

          <!-- RIGHT PANE: Output Workspace, Code Highlighter & Tools (7 cols) -->
          <div class="lg:col-span-7 bg-[var(--color-canvas)] p-4 sm:p-5 flex flex-col justify-between">
            <div>
              <!-- Output Header & Tabs -->
              <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-[var(--color-hairline)]">
                <!-- Result Format Tabs -->
                <div class="flex items-center gap-1 bg-[var(--color-canvas-soft)] p-0.5 rounded-lg border border-[var(--color-hairline)] text-xs">
                  <button
                    type="button"
                    class="output-tab-btn active px-3 py-1 font-medium rounded-md bg-[var(--color-canvas)] text-[var(--color-ink)] shadow-2xs transition-all cursor-pointer"
                    data-tab="plain-text"
                    id="tab-output-plain"
                  >
                    Texto Puro
                  </button>
                  <button
                    type="button"
                    class="output-tab-btn px-3 py-1 font-medium rounded-md text-[var(--color-body)] hover:text-[var(--color-ink)] transition-all cursor-pointer"
                    data-tab="code-view"
                    id="tab-output-code"
                  >
                    Código & Sintaxe
                  </button>
                  <button
                    type="button"
                    class="output-tab-btn px-3 py-1 font-medium rounded-md text-[var(--color-body)] hover:text-[var(--color-ink)] transition-all cursor-pointer"
                    data-tab="markdown-preview"
                    id="tab-output-markdown"
                  >
                    Markdown
                  </button>
                </div>

                <!-- Detected Language Badge & Stats -->
                <div class="flex items-center gap-2">
                  <div id="language-badge" class="hidden items-center gap-1.5 px-2 py-0.5 rounded bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] text-xs font-mono font-medium text-[var(--color-ink)]">
                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-500" aria-hidden="true"></span>
                    <span id="detected-lang-name">JavaScript</span>
                  </div>
                  <span id="stats-summary" class="text-xs font-mono text-[var(--color-mute)]">0 palavras · 0 caracteres</span>
                </div>
              </div>

              <!-- Post-Processing & Download Action Strip -->
              <div class="flex flex-wrap items-center justify-between gap-2.5 py-2.5 border-b border-[var(--color-hairline)]/80 text-xs">
                <!-- Advanced Clean & Format Tools -->
                <div class="flex flex-wrap items-center gap-1.5">
                  <button
                    type="button"
                    id="btn-beautify-code"
                    class="px-2.5 py-1 text-xs font-medium bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas-soft-2)] text-[var(--color-ink)] border border-[var(--color-hairline)] rounded-md transition-colors flex items-center gap-1 cursor-pointer"
                    title="Formatar Indentação e Sintaxe do Código"
                  >
                    <svg class="w-3 h-3 text-cyan-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m18 16 4-4-4-4"></path>
                      <path d="m6 8-4 4 4 4"></path>
                      <path d="m14.5 4-5 16"></path>
                    </svg>
                    <span>Formatar Código</span>
                  </button>

                  <button
                    type="button"
                    id="btn-clean-spaces"
                    class="px-2.5 py-1 text-xs font-medium bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas-soft-2)] text-[var(--color-ink)] border border-[var(--color-hairline)] rounded-md transition-colors flex items-center gap-1 cursor-pointer"
                    title="Remover espaços duplos e ruído de OCR"
                  >
                    <span>Limpar Ruído</span>
                  </button>

                  <!-- Case Converter Dropdown -->
                  <select
                    id="case-converter-select"
                    class="px-2 py-1 text-xs bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] rounded-md text-[var(--color-body)] hover:text-[var(--color-ink)] focus:outline-none cursor-pointer"
                    aria-label="Alterar caixa do texto"
                  >
                    <option value="" disabled selected>Mudar Formato</option>
                    <option value="uppercase">MAIÚSCULAS</option>
                    <option value="lowercase">minúsculas</option>
                    <option value="titlecase">Primeira Letra</option>
                    <option value="camelcase">camelCase</option>
                    <option value="snakecase">snake_case</option>
                  </select>

                  <!-- Text to Speech -->
                  <button
                    type="button"
                    id="btn-speech"
                    class="p-1 text-[var(--color-body)] hover:text-[var(--color-ink)] bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] rounded-md hover:bg-[var(--color-canvas-soft-2)] cursor-pointer"
                    title="Ouvir Texto (Áudio)"
                    aria-label="Ouvir texto em áudio"
                  >
