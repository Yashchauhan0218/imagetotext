---
// Navbar.astro - Glassmorphism navigation with gradient CTA
---

<header class="sticky top-0 z-50 w-full" id="site-header">
  <!-- Glass backdrop -->
  <div class="absolute inset-0 bg-white/80 dark:bg-[#0a0f1a]/85 backdrop-blur-xl border-b border-[var(--color-hairline)] transition-colors duration-300" aria-hidden="true"></div>

  <div class="relative max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 group" aria-label="Imagem Para Texto - Página Inicial">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white flex items-center justify-center shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
        </div>
        <span class="font-semibold text-[15px] tracking-tight text-[var(--color-ink)]">Imagem Para Texto</span>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center gap-0.5 pl-2" aria-label="Navegação Principal">
        <a href="/#converter-app" class="px-3.5 py-2 text-sm text-[var(--color-body)] hover:text-[var(--color-ink)] rounded-lg hover:bg-[var(--color-canvas-soft-2)] transition-all duration-150 font-medium">
          Conversor
        </a>
        <a href="/imagem-para-pdf" class="px-3.5 py-2 text-sm text-[var(--color-body)] hover:text-[var(--color-ink)] rounded-lg hover:bg-[var(--color-canvas-soft-2)] transition-all duration-150 font-medium">
          PDF
        </a>
        <a href="/#recursos" class="px-3.5 py-2 text-sm text-[var(--color-body)] hover:text-[var(--color-ink)] rounded-lg hover:bg-[var(--color-canvas-soft-2)] transition-all duration-150 font-medium">
          Recursos
        </a>
        <a href="/about" class="px-3.5 py-2 text-sm text-[var(--color-body)] hover:text-[var(--color-ink)] rounded-lg hover:bg-[var(--color-canvas-soft-2)] transition-all duration-150 font-medium">
          Sobre
        </a>
        <a href="/#faq" class="px-3.5 py-2 text-sm text-[var(--color-body)] hover:text-[var(--color-ink)] rounded-lg hover:bg-[var(--color-canvas-soft-2)] transition-all duration-150 font-medium">
          FAQ
        </a>
      </nav>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-2">
      <!-- Quick Paste Hint (Desktop) -->
      <button
        type="button"
        id="quick-paste-btn"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono text-[var(--color-mute)] bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] rounded-lg hover:text-[var(--color-body)] hover:border-[var(--color-hairline-strong)] transition-all cursor-pointer"
        title="Colar imagem (Ctrl+V)"
      >
        <span class="font-semibold text-[var(--color-ink)]">Ctrl+V</span>
        <span class="text-[10px]">Colar</span>
      </button>

      <!-- Gradient CTA -->
      <a
        href="/#converter-app"
        id="nav-primary-cta"
        class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-sm font-semibold text-white bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 rounded-full shadow-lg shadow-indigo-500/25 transition-all hover:-translate-y-0.5 active:scale-95 whitespace-nowrap"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        Experimente
      </a>

      <!-- Dark / Light Toggle -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="w-9 h-9 rounded-xl bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] hover:border-[var(--color-hairline-strong)] text-[var(--color-ink)] flex items-center justify-center transition-all hover:scale-105 active:scale-95 cursor-pointer shadow-xs"
        title="Alternar Tema"
        aria-label="Alternar Modo Escuro"
      >
        <svg id="theme-icon-sun" class="hidden w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg id="theme-icon-moon" class="w-4 h-4 text-[var(--color-body)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Mobile Hamburger -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="lg:hidden w-9 h-9 rounded-xl bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] hover:border-[var(--color-hairline-strong)] text-[var(--color-ink)] flex items-center justify-center transition-all active:scale-95 cursor-pointer shadow-xs"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="hamburger-icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="8" x2="21" y2="8"></line>
          <line x1="3" y1="16" x2="21" y2="16"></line>
        </svg>
        <svg id="close-menu-icon" class="hidden w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden relative border-b border-[var(--color-hairline)] bg-[var(--color-canvas)]/98 backdrop-blur-lg px-4 pt-3 pb-5 space-y-1"
    aria-label="Menu Mobile"
  >
    <a href="/#converter-app" class="mobile-nav-link flex items-center gap-2 px-3 py-2.5 rounded-xl text-sm font-medium text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] transition-colors">
      Imagem para Texto
    </a>
    <a href="/imagem-para-pdf" class="mobile-nav-link flex items-center gap-2 px-3 py-2.5 rounded-xl text-sm font-medium text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] transition-colors">
      Imagem para PDF
    </a>
    <a href="/#recursos" class="mobile-nav-link flex items-center gap-2 px-3 py-2.5 rounded-xl text-sm font-medium text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] transition-colors">
      Recursos
    </a>
    <a href="/about" class="mobile-nav-link flex items-center gap-2 px-3 py-2.5 rounded-xl text-sm font-medium text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] transition-colors">
      Sobre Nós
    </a>
    <a href="/contact" class="mobile-nav-link flex items-center gap-2 px-3 py-2.5 rounded-xl text-sm font-medium text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] transition-colors">
      Contato
    </a>
    <a href="/#faq" class="mobile-nav-link flex items-center gap-2 px-3 py-2.5 rounded-xl text-sm font-medium text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] transition-colors">
      FAQ
    </a>
    <div class="pt-3">
      <a href="/#converter-app" class="flex items-center justify-center gap-2 w-full px-4 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-indigo-500 to-violet-600 rounded-xl shadow-lg shadow-indigo-500/25 transition-all active:scale-95">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        Experimente Agora
      </a>
    </div>
  </div>
</header>

<script>
  // Theme Management
  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    if (sunIcon && moonIcon) {
      if (isDark) {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      }
    }
  }

  const themeBtn = document.getElementById('theme-toggle-btn');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeIcons();
    });
  }
  updateThemeIcons();

  // Scroll: add shadow to header on scroll
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 8) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Mobile Menu
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeMenuIcon = document.getElementById('close-menu-icon');

  function toggleMobileMenu(forceClose = false) {
    if (!mobileMenu || !mobileMenuBtn) return;
    const isCurrentlyHidden = mobileMenu.classList.contains('hidden');
    const shouldOpen = forceClose ? false : isCurrentlyHidden;
    if (shouldOpen) {
      mobileMenu.classList.remove('hidden');
      mobileMenuBtn.setAttribute('aria-expanded', 'true');
      hamburgerIcon?.classList.add('hidden');
      closeMenuIcon?.classList.remove('hidden');
    } else {
      mobileMenu.classList.add('hidden');
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
      hamburgerIcon?.classList.remove('hidden');
      closeMenuIcon?.classList.add('hidden');
    }
  }

  mobileMenuBtn?.addEventListener('click', () => toggleMobileMenu());
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => toggleMobileMenu(true));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
      toggleMobileMenu(true);
    }
  });
</script>

<style>
  #site-header.scrolled > div:first-child {
    box-shadow: 0 4px 24px rgba(0,0,0,0.07);
  }
  html.dark #site-header.scrolled > div:first-child {
    box-shadow: 0 4px 24px rgba(0,0,0,0.35);
  }
</style>
